# ========================================
# Bakong Vendor Bot Configuration
# ========================================

# REQUIRED: Telegram Bot Token
# Get this from @BotFather on Telegram
# 1. Search for @BotFather
# 2. Send /newbot
# 3. Follow instructions
# 4. Copy the token here
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# REQUIRED: Branch Configuration
# List your branches separated by commas
# Example: Central Market,Russian Market,Olympic Market
BRANCHES=Central Market,Russian Market,Olympic Market

# Application Settings
NODE_ENV=development
PORT=3000

# ========================================
# Optional: Bakong API Integration
# ========================================
# Only needed if you want real-time verification
# Contact Bakong for API access

BAKONG_API_URL=https://api-bakong.nbc.org.kh
BAKONG_API_KEY=your_bakong_api_key_here
BAKONG_MERCHANT_ID=your_merchant_id_here

# ========================================
# Admin Configuration
# ========================================
# Telegram User IDs of administrators
# Get your ID by sending /start to @userinfobot
# Separate multiple IDs with commas
ADMIN_USER_IDS=

# ========================================
# Database Configuration
# ========================================

# Choose your database type:
# - PostgreSQL: Set USE_POSTGRES=true (recommended for production)
# - MongoDB: Set USE_MONGODB=true (good for cloud deployment)  
# - JSON: Set both to false (simple, local only - default)

# PostgreSQL Configuration
USE_POSTGRES=false
POSTGRES_URL=postgresql://username:password@localhost:5432/bakong_bot
# Or use DATABASE_URL for services like Heroku, Railway, Render
# DATABASE_URL=postgresql://username:password@host:5432/database

# MongoDB Configuration
USE_MONGODB=false
MONGODB_URI=mongodb://localhost:27017/bakong-bot
# For MongoDB Atlas (free tier): mongodb+srv://username:password@cluster.mongodb.net/bakong-bot

# JSON File Storage (Default)
# Using JSON file storage (no configuration needed)
# Data will be stored in ./data/ folder
# Backup this folder regularly!

# ========================================
# Data Storage Locations:
# - PostgreSQL: Cloud/local database (accessible from anywhere)
# - MongoDB: Cloud database (accessible from anywhere)
# - JSON: ./data/ folder (local only)
# ========================================
